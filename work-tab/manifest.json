{
  "manifest_version": 3,
  "name": "로컬 Gemma 작업 탭",
  "version": "1.2.0",
  "key": "",
  "description": "별도 작업 창에서 Gemma가 만든 탭만 제어합니다.",
  "permissions": [
    "debugger",
    "nativeMessaging",
