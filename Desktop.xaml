</Grid></StackPanel></Grid><ScrollBar x:Name="ChatScrollBar" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Stretch" Margin="0,0,0,1" Orientation="Vertical" Maximum="{Binding ScrollableHeight,ElementName=Scroller}" ViewportSize="{Binding ViewportHeight,ElementName=Scroller}" Value="{Binding VerticalOffset,ElementName=Scroller,Mode=OneWay}" SmallChange="16" LargeChange="{Binding ViewportHeight,ElementName=Scroller}"><ScrollBar.Style><Style TargetType="ScrollBar">
  <Setter Property="Width" Value="10"/><Setter Property="Background" Value="Transparent"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="Transparent"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="10"/></Grid.RowDefinitions><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
      <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
      <Track.Thumb><Thumb MinHeight="28"><Thumb.Template><ControlTemplate TargetType="Thumb">
        <Border x:Name="Handle" Width="5" HorizontalAlignment="Right" Margin="0,1,2,1" CornerRadius="2.5" Background="#E7E8E9"/>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Background" Value="#B9BEC2"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="#92999E"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
      <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
    </Track><RepeatButton Grid.Row="1" Focusable="False" Command="ScrollBar.LineDownCommand" AutomationProperties.Name="한 줄 아래로"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Grid Background="Transparent"><Path Width="6" Height="4" Fill="#C8C9CA" Stretch="Fill" Data="M0,0 L6,0 L3,4 Z"/></Grid></ControlTemplate></RepeatButton.Template></RepeatButton></Grid>
  </ControlTemplate></Setter.Value></Setter>
<Style.Triggers><Trigger Property="Maximum" Value="0"><Setter Property="Visibility" Value="Collapsed"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0"/></Trigger></Style.Triggers></Style></ScrollBar.Style></ScrollBar></Grid></Border>
